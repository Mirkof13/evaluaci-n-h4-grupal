# FARMABOL — Variables de Entorno
# Copia este archivo como .env y completa los valores

# Puerto del servidor
PORT=3000

# Conexion a PostgreSQL (local o Supabase)
PGUSER=postgres
PGPASSWORD=postgres
PGHOST=localhost
PGPORT=5432
PGDATABASE=farmabol

# Para produccion en Supabase:
# PGUSER=farmabol_user
# PGPASSWORD=<password_supabase>
# PGHOST=<host>.supabase.co
# PGPORT=5432
# PGDATABASE=farmabol
